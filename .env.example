# Copy to .env and fill in. Never commit .env.
# Values below are for LOCAL DEVELOPMENT ONLY.

APP_ENV=development            # development | test | staging | production
APP_NAME=MyLeadToday
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# Host ports (localhost only). Change if they clash with other projects.
HTTP_PORT=8080
DEV_POSTGRES_PORT=5442
DEV_REDIS_PORT=6381
DEV_S3_PORT=8343
DEV_MAILPIT_PORT=8035

# --- PostgreSQL -------------------------------------------------------------
# Owner role: used only by migrations.
POSTGRES_DB=socialcommerce
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=change-me-owner
# Runtime roles (created by infra/postgres/init on first start).
APP_RUNTIME_DB_PASSWORD=change-me-runtime
APP_PLATFORM_DB_PASSWORD=change-me-platform

DATABASE_URL=postgresql+asyncpg://app_runtime:change-me-runtime@postgres:5432/socialcommerce
DATABASE_PLATFORM_URL=postgresql+asyncpg://app_platform:change-me-platform@postgres:5432/socialcommerce
DATABASE_MIGRATION_URL=postgresql+asyncpg://app_owner:change-me-owner@postgres:5432/socialcommerce

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Security -----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value
# Comma-separated versioned 32-byte keys, base64. Newest (last) is used for writes.
# Generate: python -c "import os,base64; print('v1:' + base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY
CORS_ORIGINS=http://localhost:8080
COOKIE_SECURE=false            # true in any environment served over HTTPS

# --- Meta (one app serves WhatsApp + Messenger) ------------------------------
# See docs/ONBOARDING_AND_CHANNEL_SETUP.md §2
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_LOGIN_CONFIG_ID_MESSENGER=
META_LOGIN_CONFIG_ID_WHATSAPP=

# --- Object storage (S3-compatible; SeaweedFS locally) -----------------------
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key-change-me
S3_BUCKET=socialcommerce

# --- Email (Mailpit locally: UI on http://localhost:8035) --------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@localhost

# --- Bootstrap platform super admin (seed command) ---------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Observability -------------------------------------------------------------
SENTRY_DSN=

# --- AI (post-MVP) ----------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
